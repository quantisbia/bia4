generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String              @id @default(cuid())
  name             String?
  email            String              @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             UserRole            @default(USER)
  institution      String?
  researchArea     String?
  bio              String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  accounts         Account[]
  chatSessions     ChatSession[]
  creditBalance    CreditBalance?
  creditTxns       CreditTransaction[]
  pipelineProjects PipelineProject[]
  protocols        Protocol[]
  sessions         Session[]
  subscription     Subscription?
  notebookEntries  NotebookEntry[]

  // R12.66 · Notebook do Pesquisador — versionamento + projetos + imagens
  projects         Project[]
  notebookVersions NotebookVersion[]
  notebookImages   NotebookImage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// R12.30: Recuperação de senha via email.
// Armazena APENAS o hash SHA-256 do token — nunca o token em claro.
// O usuário recebe o token em claro por email/UI; ao postar /reset-password
// nós comparamos hash(input) == tokenHash.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  email     String   // snapshot para anti-enumeração / auditoria
  tokenHash String   @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([email])
  @@index([expires])
  @@map("password_reset_tokens")
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  plan               SubscriptionPlan   @default(FREE)
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime           @default(dbgenerated("(now() + '7 days'::interval)"))
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  monthlyCredits     Int                @default(50)
  externalId         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditBalance {
  id          String   @id @default(cuid())
  userId      String   @unique
  balance     Int      @default(50)
  totalEarned Int      @default(50)
  totalSpent  Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

model CreditTransaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int
  balance     Int
  description String
  metadata    Json?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("credit_transactions")
}

model PipelineProject {
  id                String          @id @default(cuid())
  userId            String
  name              String
  description       String?
  tissueType        String
  cellSource        String?
  status            PipelineStatus  @default(DRAFT)
  currentStage      Int             @default(1)
  targetApplication String?
  patientProfile    String?
  completionRate    Float           @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages            PipelineStage[]

  @@index([userId])
  @@index([status])
  @@map("pipeline_projects")
}

model PipelineStage {
  id          String          @id @default(cuid())
  projectId   String
  stageNumber Int
  name        String
  description String
  status      StageStatus     @default(PENDING)
  inputs      Json?
  outputs     Json?
  aiAnalysis  String?
  creditsUsed Int?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     PipelineProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageNumber])
  @@index([projectId])
  @@map("pipeline_stages")
}

model Biomaterial {
  id               String              @id @default(cuid())
  name             String
  category         BiomaterialCategory
  components       String[]
  composition      Json
  elasticity       Float?
  porosity         Float?
  degradationTime  String?
  biocompatibility String
  printable        Boolean             @default(false)
  crosslinking     String?
  applications     String[]
  tissueTypes      String[]
  references       String[]
  doi              String[]
  tags             String[]
  isPublic         Boolean             @default(true)
  verified         Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  formulations     FormulationRecord[]

  @@index([category])
  @@map("biomaterials")
}

model FormulationRecord {
  id            String      @id @default(cuid())
  userId        String?
  biomaterialId String
  customInputs  Json?
  aiSuggestion  String?
  notes         String?
  creditsUsed   Int         @default(10)
  createdAt     DateTime    @default(now())
  biomaterial   Biomaterial @relation(fields: [biomaterialId], references: [id], onDelete: NoAction)

  @@index([biomaterialId])
  @@map("formulation_records")
}

model OrganoidDesign {
  id           String       @id @default(cuid())
  userId       String
  name         String
  organoidType OrganoidType
  cellTypes    String[]
  scaffold     String?
  dimensions   Json?
  protocol     String?
  aiDesign     String?
  predictions  Json?
  purpose      String?
  cellSource   String?
  creditsUsed  Int          @default(15)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@map("organoid_designs")
}

model Protocol {
  id           String   @id @default(cuid())
  userId       String
  title        String
  category     String
  description  String?
  content      String?
  steps        Json
  materials    Json
  equipment    String[]
  safetyNotes  String[]
  aiGenerated  Boolean  @default(true)
  sourceInputs Json?
  duration     String?
  difficulty   String?
  validated    Boolean  @default(false)
  creditsUsed  Int      @default(8)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("protocols")
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  authors     String[]
  abstract    String
  journal     String
  year        Int
  doi         String?  @unique
  url         String?
  tags        String[]
  category    String
  keywords    String[]
  embedding   Float[]
  chunkCount  Int      @default(0)
  isPublic    Boolean  @default(true)
  accessCount Int      @default(0)
  // R12 — Motor de Conhecimento: tipos e uploads de usuário
  kind        String   @default("article") // "article" | "patent" | "methodology" | "user_upload"
  source      String?  // ex: "internal", "pubmed", "scholar", "wipo", "user"
  fileUrl     String?  // URL do arquivo enviado pelo usuário (storage)
  fileName    String?  // nome original do arquivo
  fileType    String?  // pdf/docx/txt/md
  fileSize    Int?     // bytes
  uploadedBy  String?  // userId — quem fez o upload
  textContent String?  // extracted text para busca/RAG
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([year])
  @@index([kind])
  @@index([uploadedBy])
  @@map("knowledge_articles")
}

model ChatSession {
  id           String        @id @default(cuid())
  userId       String
  title        String        @default("Nova Conversa")
  isActive     Boolean       @default(true)
  context      String?
  messageCount Int           @default(0)
  totalCredits Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  role        String
  content     String
  model       String?
  tokens      Int?
  creditsUsed Int         @default(0)
  sources     Json?
  createdAt   DateTime    @default(now())
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ─── Notebook do Pesquisador ──────────────────────────────────────────────────
model NotebookEntry {
  id           String            @id @default(cuid())
  userId       String
  // R12.66 · projeto opcional (organização hierárquica projeto → entrada)
  projectId    String?
  title        String
  content      String            @db.Text
  entryType    NotebookEntryType @default(NOTE)
  category     String?           // ex: "Protocolo", "Formulação", "Pipeline"
  tags         String[]          @default([])
  sourceType   String?           // "protocol", "pipeline", "biomaterial", "chat", "manual"
  sourceId     String?           // ID do item de origem
  isPinned     Boolean           @default(false)
  isPublic     Boolean           @default(false)
  visibility   String            @default("private") // "private", "institution", "public"
  generatedDoc Json?             // artigo, patente, livro gerado por IA
  metadata     Json?             // dados extras (parâmetros, referências, etc.)
  // R12.66 · rastreabilidade — nº da versão CORRENTE (autoritativa, sempre >= 1)
  currentVersion Int             @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions     NotebookVersion[]
  images       NotebookImage[]

  @@index([userId])
  @@index([projectId])
  @@index([entryType])
  @@index([isPinned])
  @@index([createdAt])
  @@map("notebook_entries")
}

// ─── R12.66 · Histórico de Versões do Notebook ─────────────────────────
// Cada alteração em NotebookEntry gera automaticamente uma nova
// NotebookVersion (à menos que ?updateInPlace=true). Preserva o
// conteúdo antes e depois para rastreabilidade completa.
model NotebookVersion {
  id            String        @id @default(cuid())
  entryId       String
  userId        String        // autor da alteração (sessão NextAuth)
  versionNumber Int           // 1, 2, 3, ... — único por entryId
  changeSummary String?       // descrição resumida do que mudou (opcional)
  // Snapshot dos campos versionados. Guardamos JSON pra não engessar:
  //   { title, content, tags, category, entryType, generatedDoc, metadata }
  snapshot      Json
  // Snapshot anterior — pra permitir "compare" e "restaurar" sem
  // precisar carregar 2 versões contíguas.
  previousSnapshot Json?
  createdAt     DateTime      @default(now())

  entry         NotebookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, versionNumber])
  @@index([entryId])
  @@index([userId])
  @@index([createdAt])
  @@map("notebook_versions")
}

// ─── R12.66 · Imagens anexadas ao Notebook ─────────────────────────────
// Armazenamento inicial: base64 em `dataBase64` (dataURL completo).
// R12.70+ migrará para Vercel Blob (URL externa em `storageUrl`).
model NotebookImage {
  id            String   @id @default(cuid())
  entryId       String?  // pode ser imagem "solta" (galeria geral)
  userId        String
  title         String?
  caption       String?
  experimentId  String?  // ID livre de experimento (organização)
  sampleNumber  String?
  tags          String[] @default([])
  observations  String?
  // Associação opcional a UMA versão específica do protocolo
  versionNumber Int?
  mimeType      String   // "image/png", "image/jpeg", "image/webp"
  sizeBytes     Int
  // Armazenamento (um dos dois preenchido):
  dataBase64    String?  @db.Text   // dataURL "data:image/png;base64,...."
  storageUrl    String?              // futuro: Vercel Blob URL
  width         Int?
  height        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entry         NotebookEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([userId])
  @@index([experimentId])
  @@index([createdAt])
  @@map("notebook_images")
}

// ─── R12.66 · Projetos científicos (organização do Notebook) ───────────
// Um projeto é um "guarda-chuva" que agrega várias NotebookEntry
// (protocolos, formulações, resultados, imagens). Diferente de
// PipelineProject (que é a pipeline experimental de 10 fases).
// Nada impede que no futuro se faça um join opcional dos dois.
model Project {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String?
  // Área de pesquisa livre (ex: "Regenerativa - cartilagem")
  researchArea String?
  color        String?  // "#a78bfa" — para UI de cores
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries      NotebookEntry[]

  @@index([userId])
  @@index([isArchived])
  @@index([createdAt])
  @@map("projects")
}

enum NotebookEntryType {
  NOTE
  PROTOCOL
  FORMULATION
  PIPELINE_SUMMARY
  ARTICLE_DRAFT
  PATENT_DRAFT
  BOOK_CHAPTER
  RESEARCH_LOG
  REFERENCE
  STL_GEOMETRY
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserRole {
  USER
  ADMIN
  RESEARCHER
}

enum SubscriptionPlan {
  FREE
  ORGANOID_LAB
  DISCOVERY
  ADVANCED
  ENTERPRISE
  ACADEMY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum PipelineStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum BiomaterialCategory {
  HYDROGEL
  SCAFFOLD
  BIOINK
  MEMBRANE
  COATING
  COMPOSITE
  DECELLULARIZED
  NANOPARTICLE
}

enum OrganoidType {
  BRAIN
  HEART
  LIVER
  KIDNEY
  INTESTINE
  LUNG
  PANCREAS
  RETINA
  CUSTOM
}
