# ============================================
# BIA v3 - Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha
# ============================================

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="sua-chave-secreta-super-forte-aqui"
NEXTAUTH_URL="http://localhost:3000"

# IA — Anthropic Claude (R49: toda a IA da plataforma usa esta chave)
# Obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-..."
# Opcionais: modelo (padrão claude-haiku-5-5; ex.: claude-sonnet-5-5) e esforço (low | medium | high)
# BIA_AI_MODEL="claude-haiku-5-5"
# BIA_AI_EFFORT="low"

# ============================================
# Email (Resend) — OPCIONAL — R12.30
# Usado para enviar emails de redefinição de senha.
# Se NÃO definido, o sistema cai em modo "fallback":
# exibe o link direto na tela após o usuário pedir reset.
# ============================================
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="BIA <onboarding@resend.dev>"  # padrão: onboarding@resend.dev

# App
NODE_ENV="development"
